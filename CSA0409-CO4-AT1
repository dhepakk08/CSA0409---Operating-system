        #include <stdio.h>

        int main() {
            int n, page, offset, frame;
            int pageTable[20];

        // Get the number of pages
            printf("Enter the number of pages: ");
            scanf("%d", &n);
    
        // Read frame numbers for each page
            printf("Enter frame numbers:\n");
            for (int i = 0; i < n; i++) {
                printf("Page %d -> Frame: ", i);
                scanf("%d", &pageTable[i]);
            }

        // Read logical address (page number and offset)
            printf("Enter Page Number and Offset: ");
            scanf("%d %d", &page, &offset);

