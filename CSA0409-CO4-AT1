4) Aim: To design and implement Translation Lookaside Buffer (TLB)
   
   Program: 
        #include <stdio.h>

        int main() {
            int memory = 100, tlb = 20;
            float hit;

            printf("Enter TLB Hit Ratio (0 to 1): ");
            scanf("%f", &hit);

            printf("Without TLB = %d ns\n", 2 * memory);

            printf("With TLB = %.2f ns\n",
                    hit * (tlb + memory) +
                    (1 - hit) * (tlb + 2 * memory));

            return 0;
        }

