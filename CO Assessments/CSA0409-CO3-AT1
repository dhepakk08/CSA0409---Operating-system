2) Aim: To design and implement paging memory management

   Program:
        #include <stdio.h>

        int main() {
            int n, page, offset, frame;
            int pageTable[20];

        // Get the number of pages
            printf("Enter the number of pages: ");
            scanf("%d", &n);
    
        // Read frame numbers for each page
            printf("Enter frame numbers:\n");
            for (int i = 0; i < n; i++) {
                printf("Page %d -> Frame: ", i);
                scanf("%d", &pageTable[i]);
            }

        // Read logical address (page number and offset)
            printf("Enter Page Number and Offset: ");
            scanf("%d %d", &page, &offset);

        // Check whether the page number is valid
            if (page >= 0 && page < n) {
              frame = pageTable[page];

              // Calculate physical address
              printf("Physical Address = %d\n", frame * 100 + offset);
              } else {
                printf("Invalid Page Number!\n");
              }

              return 0;
        }

   Output:
        Enter the number of pages: 2
        Enter frame numbers:
        Page 0 -> Frame: 5
        Page 1 -> Frame: 3
        Enter Page Number and Offset: 1 50
        Physical Address = 350

