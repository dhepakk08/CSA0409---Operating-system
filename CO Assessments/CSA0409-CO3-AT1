1) Aim: To design and implement the identification of physical address using logical address

   Program:
          #include <stdio.h>

          int main() {
                int base, limit, logical;

                // Initialising Base, limit registers and logical address 

                printf("Enter Base Register: ");
                scanf("%d", &base);

                printf("Enter Limit Register: ");
                scanf("%d", &limit);

                printf("Enter Logical Address: ");
                scanf("%d", &logical);
 
                //Condition to check the address is valid or not
      
                if (logical < limit) { 
                  
                      printf("The physical address is Valid!\n");
                      printf("Physical Address = %d\n", base + logical);
                }      
                else {
                      printf("Invalid Logical Address!\n");
                }
                return 0;
          }

